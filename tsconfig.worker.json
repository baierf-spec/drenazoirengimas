{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "noUnusedLocals": true,
    "resolveJsonModule": true
  },
  "include": [
    "worker/**/*.ts",
    "src/lib/validation.ts",
    "src/lib/estimator.ts",
    "src/lib/diagnostic.ts",
    "shared/**/*.ts"
  ]
}
