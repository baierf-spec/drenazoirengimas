# Public values are embedded at build time. Never place secrets in PUBLIC_* values.
PUBLIC_SITE_MODE=preview
PUBLIC_PHONE=
PUBLIC_CONTACT_EMAIL=
PUBLIC_CONTROLLER_NAME=
PUBLIC_CONTROLLER_ADDRESS=
PUBLIC_TURNSTILE_SITE_KEY=
PUBLIC_GA4_ID=
PUBLIC_CF_ANALYTICS_TOKEN=
PUBLIC_GOOGLE_SITE_VERIFICATION=
# Copy server entries to .dev.vars for local Wrangler; configure Secrets in Cloudflare.
LEADS_ENABLED=false
SEO_INDEXABLE=false
SITE_ORIGIN=https://drenazoirengimas.lt
ALLOWED_ORIGINS=https://drenazoirengimas.lt
TURNSTILE_SECRET_KEY=
# EMAIL is a native send_email binding, not an API key.
EMAIL_FROM=
ADMIN_EMAIL=
BUSINESS_REPLY_TO=

