---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import FAQ from "../components/FAQ.astro";
import WaterDiagram from "../components/WaterDiagram.astro";
import { site, problems, services, faq } from "../data/site";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Drenažo įrengimas",
    serviceType: "Sklypo ir pamatų vandens valdymo sprendimai",
    areaServed: { "@type": "Country", name: "Lithuania" },
    description:
      "Užklausų dėl drenažo įrengimo surinkimas. Galimybė atlikti darbus tikslinama individualiai.",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.slice(0, 6).map(([name, text]) => ({
      "@type": "Question",
      name,
      acceptedAnswer: { "@type": "Answer", text },
    })),
  },
];
---

<Base
  title="Drenažo įrengimas namams ir sklypui | drenazoirengimas.lt"
  description="Drenažo įrengimas, sklypo ir pamatų vandens problemų įvertinimas. Užklausos Vilniuje, Kaune ir visoje Lietuvoje. Aprašykite situaciją ir pridėkite nuotraukas."
  overlay
  schema={schema}
>
  <section class="hero">
    <picture class="hero-picture">
      <source
        type="image/avif"
        srcset="/images/hero-768.avif 768w, /images/hero-1440.avif 1440w, /images/hero-1920.avif 1920w"
        sizes="100vw"
      />
      <img
        src="/images/hero-1440.webp"
        srcset="/images/hero-768.webp 768w, /images/hero-1440.webp 1440w, /images/hero-1920.webp 1920w"
        sizes="100vw"
        width="1792"
        height="1024"
        alt="Iliustracinis namo pjūvis: drenažo vamzdis grunto ir skaldos sluoksnyje"
        fetchpriority="high"
        loading="eager"
      />
    </picture>
    <div class="container hero-content">
      <span class="eyebrow hero-eyebrow">
        <Icon name="water" size={15} /> APGALVOTI VANDENS SPRENDIMAI
      </span>
      <h1>
        Drenažo įrengimas
        <br />
        sklypui ir
        <br />
        pamatams
      </h1>
      <p>
        Šlapias kiemas ar drėgni pamatai? Aprašykite problemą – pirmiausia
        reikia nustatyti, iš kur atiteka vanduo ir kur jį galima nuvesti.
      </p>
      <p class="hero-area">Vilnius, Kaunas ir užklausos iš visos Lietuvos.</p>
      <div class="hero-actions">
        <a
          class="button"
          href="/gauti-pasiulyma/"
          data-event="primary_cta_click"
        >
          Gauti pasiūlymą <Icon name="arrow" size={19} />
        </a>
        <a
          class="button button-glass"
          href={site.phone ? `tel:${site.phone}` : "/gauti-pasiulyma/?photos=1"}
          data-event={site.phone ? "phone_click" : "primary_cta_click"}
        >
          <Icon name={site.phone ? "phone" : "camera"} size={19} />
          {site.phone ? "Skambinti" : "Atsiųsti nuotraukas"}
        </a>
      </div>
    </div>
    <div class="container hero-services">
      {[
        ["house", "Namų pamatams"],
        ["trees", "Sklypų sausinimui"],
        ["basement", "Rūsiams"],
        ["land", "Kiemo teritorijoms"],
      ].map(([icon, text]) => (
        <a href="/#paslaugos">
          <Icon name={icon} size={29} />
          <span>{text}</span>
        </a>
      ))}
    </div>
  </section>
  <section class="section container" id="problemos">
    <div class="section-heading split">
      <div>
        <span class="eyebrow">KAI VANDENS PER DAUG</span>
        <h2>
          Kokias vandens
          <br />
          problemas sprendžia drenažas?
        </h2>
        <p>
          Vanduo sklype gali kauptis dėl grunto, reljefo ar lietaus nuvedimo.
          Tinkamą sprendimą padeda pasirinkti priežasties įvertinimas.
        </p>
      </div>
      <ul class="check-list">
        <li>
          <Icon name="check" />
          Vandens šaltinio įvertinimas
        </li>
        <li>
          <Icon name="check" />
          Sprendimas pagal objekto sąlygas
        </li>
        <li>
          <Icon name="check" />
          Aiški darbų ir sąmatos apimtis
        </li>
        <li>
          <Icon name="check" />
          Aptartas gerbūvio atkūrimas
        </li>
      </ul>
    </div>
    <div class="problem-grid">
      {problems.map((p) => (
        <a class="problem-card" href={p.href}>
          <div class="problem-image">
            <img
              src={`/images/${p.id}.webp`}
              width="640"
              height="480"
              loading="lazy"
              srcset={`/images/${p.id}-320.webp 320w, /images/${p.id}.webp 640w`}
              sizes="(max-width: 600px) 104px, (max-width: 850px) 45vw, 282px"
              alt={`Iliustracija: ${p.title.toLowerCase()}`}
            />
          </div>
          <div class="problem-body">
            <h3>{p.title}</h3>
            <p>{p.text}</p>
            <span class="card-link">
              Apie problemą <Icon name="arrow" size={17} />
            </span>
          </div>
        </a>
      ))}
    </div>
    <div class="inline-callout">
      <div class="inline-icon">
        <Icon name="water" size={27} />
      </div>
      <div>
        <strong>Nežinote, ar jums reikia drenažo?</strong>
        <p>Trumpas klausimynas padės pasiruošti pokalbiui su specialistu.</p>
      </div>
      <a class="text-link" href="/diagnostika/">
        Įvertinti situaciją <Icon name="arrow" size={19} />
      </a>
    </div>
  </section>
  <section class="section section-tint" id="veikimas">
    <div class="container diagram-grid">
      <div>
        <span class="eyebrow">AIŠKIAI APIE TAI, KAS PO ŽEME</span>
        <h2>
          Kaip veikia
          <br />
          drenažo sistema?
        </h2>
        <p>
          Ji surenka perteklinį vandenį grunte ir nukreipia jį į konkrečiam
          objektui tinkamą priėmimo vietą.
        </p>
        <p>
          <strong>
            Nepradedame nuo vamzdžių. Pradedame nuo vandens priežasties.
          </strong>{" "}
          Pirmiausia svarbu suprasti, iš kur vanduo atiteka ir kur jį galima
          saugiai nuvesti.
        </p>
        <a class="text-link" href="/drenazas-ar-lietaus-nuotekos/">
          Drenažas ir lietaus vanduo <Icon name="arrow" size={19} />
        </a>
      </div>
      <WaterDiagram />
    </div>
  </section>
  <section class="section container benefits">
    <div class="section-heading">
      <span class="eyebrow">APGALVOTAS SPRENDIMAS</span>
      <h2>Kodėl verta įvertinti drenažą?</h2>
    </div>
    <div class="benefit-grid">
      {[
        [
          "shield",
          "Mažiau drėgmės rizikos",
          "Tinkamas vandens valdymas padeda mažinti drėgmės poveikį konstrukcijoms.",
        ],
        [
          "house",
          "Rūpestis namo būkle",
          "Drenažas vertinamas kartu su reljefu, lietaus vandeniu ir hidroizoliacija.",
        ],
        [
          "trees",
          "Patogiau naudotis kiemu",
          "Sprendžiama, kodėl sklype laikosi balos ir ilgai neišdžiūsta veja.",
        ],
        [
          "document",
          "Aiškesnė darbų apimtis",
          "Aiškus planas, darbų apimtis ir sąmata prieš priimant sprendimą.",
        ],
      ].map(([icon, title, text]) => (
        <article>
          <span class="round-icon">
            <Icon name={icon} />
          </span>
          <h3>{title}</h3>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section section-tint" id="paslaugos">
    <div class="container">
      <div class="section-heading">
        <span class="eyebrow">SPRENDIMAS PAGAL PROBLEMĄ</span>
        <h2>Sklypo ir pamatų drenažo sprendimai</h2>
        <p>
          Pamatų drenažas, sklypo sausinimas ir lietaus vandens surinkimas
          atlieka skirtingas užduotis.
        </p>
      </div>
      <div class="service-grid">
        {services.map((s) => (
          <article class="service-card">
            <div class="service-top">
              <Icon name={s.icon} size={32} />
              <span class="eyebrow">{s.tag}</span>
            </div>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="text-link" href={`/${s.slug}/`}>
              Apie sprendimą <Icon name="arrow" size={18} />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section container" id="procesas">
    <div class="section-heading split">
      <div>
        <span class="eyebrow">NUO SITUACIJOS IKI AIŠKAUS PLANO</span>
        <h2>Kaip vyksta darbai?</h2>
      </div>
      <p>
        Rangovą ir darbų apimtį renkatės žinodami, kas siūloma ir kodėl.
        Kiekvienas etapas derinamas individualiai.
      </p>
    </div>
    <ol class="process-grid">
      {[
        [
          "Situacija",
          "Aprašote problemą, vietą ir, jei galite, pridedate nuotraukas.",
        ],
        [
          "Įvertinimas",
          "Tikslinamos sąlygos, vandens kelias ir apžiūros poreikis.",
        ],
        ["Sąmata", "Su rangovu suderinate darbų apimtį, kainą ir atsakomybes."],
        ["Įrengimas", "Darbai atliekami pagal suderintą sprendimą ir sąlygas."],
        [
          "Dokumentacija",
          "Verta sutarti dėl užkasamų darbų nuotraukų ir sistemos schemos.",
        ],
      ].map(([title, text], i) => (
        <li>
          <span class="step-number">0{i + 1}</span>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ol>
  </section>
  <section class="price-band">
    <div class="container price-band-inner">
      <div>
        <span class="eyebrow">KAS ĮEINA Į SĄMATĄ</span>
        <h2>
          Drenažo kaina:
          <br />
          kas ją lemia?
        </h2>
        <p>
          Kainą lemia ne vien metrai. Svarbu gruntas, privažiavimas, vandens
          nuvedimas ir esamos dangos.
        </p>
        <a href="/drenazo-kaina/" class="button" data-event="primary_cta_click">
          Peržiūrėti kainos skaičiuoklę <Icon name="arrow" size={19} />
        </a>
      </div>
      <div class="price-factor-grid">
        {[
          ["land", "Gruntas ir kasimo sąlygos"],
          ["water", "Vandens surinkimas ir nuvedimas"],
          ["building", "Privažiavimas technikai"],
          ["trees", "Gerbūvio atkūrimas"],
        ].map(([icon, text]) => (
          <div>
            <Icon name={icon} />
            <span>{text}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
  <section class="section container" id="teritorija">
    <div class="area-grid">
      <div>
        <span class="eyebrow">JŪSŲ VIETA – SVARBI</span>
        <h2>
          Vilnius. Kaunas.
          <br />
          Ir jūsų sklypas.
        </h2>
        <p>
          Užklausą galite pateikti iš bet kurios Lietuvos vietovės. Galimybė
          pasiūlyti rangovą konkrečioje vietovėje tikslinama pagal partnerių
          aprėptį ir užimtumą.
        </p>
        <div class="area-tags">
          <span>
            <Icon name="pin" size={17} />
            Vilnius ir rajonas
          </span>
          <span>
            <Icon name="pin" size={17} />
            Kaunas ir rajonas
          </span>
          <span>Kitos Lietuvos vietovės</span>
        </div>
      </div>
      <div class="area-note">
        <Icon name="camera" size={36} />
        <h3>Pradėti pakanka vietos ir problemos aprašymo</h3>
        <p>
          Nereikia žinoti vamzdžių ilgio ar grunto sudėties. Parodykite, kur
          kaupiasi vanduo – klausimus patikslinsime pirmojo pokalbio metu.
        </p>
        <a class="text-link" href="/gauti-pasiulyma/?photos=1">
          Atsiųsti objekto nuotraukas <Icon name="arrow" size={18} />
        </a>
      </div>
    </div>
  </section>
  <section class="section section-tint" id="duk">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow">PRIEŠ APSISPRENDŽIANT</span>
        <h2>
          Dažniausi
          <br />
          klausimai
        </h2>
        <p>Apie drenažo poreikį, kainą ir vandens nuvedimą.</p>
        <a href="/duk/" class="text-link">
          Visi atsakymai <Icon name="arrow" size={18} />
        </a>
      </div>
      <FAQ limit={6} />
    </div>
  </section>
  <section class="section container" id="kontaktai">
    <div class="final-cta">
      <div>
        <span class="eyebrow">PIRMAS ŽINGSNIS – PAPRASTAS</span>
        <h2>
          Parodykite problemą.
          <br />
          Pradėkime nuo situacijos.
        </h2>
        <p>
          Objekto vieta, problema ir jūsų kontaktai.
          <br />
          Nuotraukos neprivalomos, bet labai naudingos.
        </p>
      </div>
      <div>
        <a
          class="button"
          href="/gauti-pasiulyma/"
          data-event="primary_cta_click"
        >
          Gauti pasiūlymą <Icon name="arrow" />
        </a>
        <span class="small">Be įsipareigojimo užsakyti darbus.</span>
      </div>
    </div>
  </section>
</Base>
