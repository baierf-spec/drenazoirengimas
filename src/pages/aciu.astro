---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base
  title="Užklausos patvirtinimas | drenazoirengimas.lt"
  description="Pateiktos užklausos būsena ir tolesni žingsniai."
  simple
  noindex
>
  <section class="flow-shell flow-message">
    <span class="round-icon">
      <Icon name="document" size={28} />
    </span>
    <h1>Užklausos patvirtinimas</h1>
    <p id="success-copy">
      Užklausą galite pateikti objekto ir kontaktų formoje. Vien šio puslapio
      atidarymas jos neišsiunčia.
    </p>
    <p class="small" data-received-note hidden>
      Jei nurodėte el. paštą ir įjungtas patvirtinimų siuntimas, gavimo
      patvirtinimas bus išsiųstas į jį. Darbų apimtį bei sąlygas su rangovu
      suderinsite atskirai.
    </p>
    <a class="button" href="/gauti-pasiulyma/">
      Gauti pasiūlymą <Icon name="arrow" size={18} />
    </a>
  </section>
  <script>
    import { initConfirmation } from "../scripts/confirmation";
    initConfirmation();
  </script>
</Base>
