---
import Base from "../layouts/Base.astro";
---

<Base
  title="Projektų galerijos valdymas | drenazoirengimas.lt"
  description="Privatus svetainės savininko projektų galerijos valdymas."
  noindex
  simple
>
  <section class="container gallery-manager" aria-labelledby="manager-title">
    <div class="manager-heading">
      <div>
        <span class="eyebrow">TIK SVETAINĖS SAVININKUI</span>
        <h1 id="manager-title">Projektų galerija</h1>
      </div>
      <a class="text-link" href="/projektai/" target="_blank" rel="noopener">
        Atidaryti galeriją ↗
      </a>
    </div>
    <p class="manager-help">
      Pridėkite nuotraukas, trumpai aprašykite darbus ir pasirinkite viršelį.
    </p>
    <p id="manager-status" role="status" aria-live="polite">
      Įkeliamas projektų sąrašas…
    </p>
    <p id="manager-error" class="form-error" role="alert" hidden></p>
    <div class="manager-layout">
      <aside class="manager-projects" aria-label="Jūsų projektai">
        <button class="button" type="button" id="new-project">
          + Naujas projektas
        </button>
        <div id="owner-project-list"></div>
      </aside>
      <div>
        <div id="manager-welcome" class="notice">
          <h2>Vieta jūsų atliktiems darbams</h2>
          <p>
            Pasirinkite projektą arba spauskite „Naujas projektas“. Juodraščiai
            lankytojams nematomi.
          </p>
        </div>
        <form id="project-editor" hidden>
          <div class="manager-editor-heading">
            <h2 id="editor-heading">Naujas projektas</h2>
            <span id="project-state" class="eyebrow">
              JUODRAŠTIS
            </span>
          </div>
          <div
            id="gallery-drop"
            class="gallery-drop"
            tabindex="0"
            role="button"
            aria-label="Pasirinkti projekto nuotraukas"
          >
            <strong>Pridėti nuotraukų</strong>
            <p>Bakstelėkite arba nutempkite failus čia.</p>
            <span class="small">
              JPG, PNG, WebP, HEIC / HEIF · iki 20 nuotraukų · iki 20 MB viena
            </span>
          </div>
          <input
            type="file"
            id="gallery-files"
            multiple
            accept="image/jpeg,image/png,image/webp,image/heic,image/heif,.heic,.heif"
            class="visually-hidden"
            tabindex="-1"
            aria-label="Projekto nuotraukos"
          />
          <p class="small">
            Nuotraukos paruošiamos automatiškai. Rinkitės tik savo darbus;
            venkite žmonių, automobilių numerių ir dokumentų.
          </p>
          <ul
            id="upload-queue"
            class="upload-queue"
            aria-label="Įkeliamos nuotraukos"
          ></ul>
          <div
            id="owner-photos"
            class="owner-photos"
            aria-label="Projekto nuotraukų tvarka"
          ></div>
          <p class="small">
            ★ pažymėkite viršelį. Tvarką keiskite rodyklėmis arba tempdami
            nuotraukas.
          </p>
          <label class="field">
            <span>Projekto pavadinimas *</span>
            <input
              name="title"
              required
              minlength="3"
              maxlength="120"
              placeholder="Trumpai įvardykite atliktus darbus"
            />
          </label>
          <label class="field">
            <span>Trumpas aprašymas *</span>
            <textarea
              name="description"
              required
              minlength="20"
              maxlength="2000"
              rows="4"
              placeholder="Kokia buvo situacija ir ką atlikote?"
            ></textarea>
          </label>
          <div class="manager-fields">
            <label class="field">
              <span>
                Vietovė <small>(neprivaloma)</small>
              </span>
              <input
                name="location"
                maxlength="120"
                placeholder="Miestas ar rajonas, be tikslaus adreso"
              />
            </label>
            <label class="field">
              <span>
                Darbų tipas <small>(neprivaloma)</small>
              </span>
              <select name="project_type">
                <option value="">Nenurodyta</option>
                <option value="foundation">Pamatų drenažas</option>
                <option value="plot">Sklypo drenažas</option>
                <option value="rain">Lietaus vandens nuvedimas</option>
                <option value="other">Kita</option>
              </select>
            </label>
          </div>
          <label class="field">
            <span>
              Užbaigimo metai arba data <small>(neprivaloma)</small>
            </span>
            <input
              name="completion_date"
              maxlength="10"
              inputmode="numeric"
              placeholder="2026 arba 2026-10-20"
            />
          </label>
          <div class="manager-actions">
            <button
              type="button"
              class="button button-outline"
              id="save-project"
            >
              Išsaugoti juodraštį
            </button>
            <button type="submit" class="button" id="publish-project">
              Publikuoti
            </button>
            <button
              type="button"
              class="text-button"
              id="unpublish-project"
              hidden
            >
              Paslėpti iš galerijos
            </button>
          </div>
          <p class="small" id="save-note">
            Juodraštis saugomas privačiai. Publikuokite tik tikrus darbus ir
            nuotraukas, kurias turite teisę viešinti.
          </p>
          <button
            class="text-button manager-delete"
            id="delete-project"
            type="button"
            hidden
          >
            Ištrinti projektą
          </button>
        </form>
      </div>
    </div>
  </section>
  <script>
    import { initGalleryManager } from "../scripts/gallery-manager";
    initGalleryManager();
  </script>
</Base>
