---
import "@fontsource-variable/manrope";
import "../styles/global.css";
import media from "../data/generated-media.json";
import { pageMeta } from "../data/pages";
import { site } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
  title: string;
  description: string;
  overlay?: boolean;
  simple?: boolean;
  noindex?: boolean;
  ogImage?: string;
  schema?: Record<string, unknown>[];
}
const {
  title,
  description,
  overlay = false,
  simple = false,
  noindex = false,
  ogImage,
  schema = [],
} = Astro.props;
const canonicalPath = ["/404", "/404/"].includes(Astro.url.pathname)
  ? "/404.html"
  : Astro.url.pathname;
const meta = pageMeta(canonicalPath);
const resolvedTitle = meta?.title ?? title;
const resolvedDescription = meta?.description ?? description;
const resolvedImage =
  (meta?.ogImage && (media as Record<string, string>)[meta.ogImage]) || ogImage;
const preventIndexing =
  noindex || meta?.indexable === false || !site.production;
const canonical = new URL(canonicalPath, site.origin).href;
const baseSchema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": site.origin + "/#website",
    name: site.name,
    url: site.origin + "/",
    inLanguage: "lt-LT",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonical + "#webpage",
    name: resolvedTitle,
    description: resolvedDescription,
    isPartOf: { "@id": site.origin + "/#website" },
    url: canonical,
    inLanguage: "lt-LT",
  },
  ...schema,
];
const config = {
  ga4: site.ga4,
  cloudflare: site.cloudflareAnalytics,
  attribution: site.attributionEnabled,
};
---

<!doctype html>
<html lang="lt">
  <head>
    {site.ga4 && (
      <>
        <!-- Google tag (gtag.js) -->
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${site.ga4}`}
        ></script>
        <script
          is:inline
          set:html={`window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', ${JSON.stringify(site.ga4)});`}
        ></script>
      </>
    )}
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonical} />
    <meta
      name="robots"
      content={preventIndexing ? "noindex, follow" : "index, follow"}
    />
    <meta name="theme-color" content="#082536" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="lt_LT" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={
        resolvedImage
          ? new URL(resolvedImage, site.origin).href
          : `${site.origin}/images/og.jpg`
      }
    />
    <meta
      property="og:image:alt"
      content={
        resolvedImage
          ? resolvedTitle
          : "Iliustracinis namo ir drenažo sistemos pjūvis"
      }
    />
    {!resolvedImage && <meta property="og:image:width" content="1200" />}
    {!resolvedImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta
      name="twitter:image"
      content={
        resolvedImage
          ? new URL(resolvedImage, site.origin).href
          : `${site.origin}/images/og.jpg`
      }
    />
    {site.verification && (
      <meta name="google-site-verification" content={site.verification} />
    )}
    {baseSchema.map((item) => (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
      />
    ))}
    <script
      id="analytics-config"
      type="application/json"
      set:html={JSON.stringify(config).replace(/</g, "\\u003c")}
    />
    <slot name="head" />
  </head>
  <body class:list={[{ "flow-page": simple }]}>
    <a class="skip-link" href="#main">
      Pereiti prie turinio
    </a>
    <Header overlay={overlay} simple={simple} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!simple && <Footer />}
    <section class="consent-panel" aria-labelledby="consent-title" hidden>
      <div>
        <strong id="consent-title">Jūsų privatumo pasirinkimas</strong>
        <p>
          Papildomus analitikos įvykius ir atėjimo šaltinio įsiminimą įjungiame
          tik jums sutikus. Forma veikia ir jos atsisakius.{" "}
          <a href="/privatumo-politika/">Plačiau</a>
        </p>
      </div>
      <div class="consent-actions">
        <button
          type="button"
          class="button button-outline"
          data-consent="denied"
        >
          Tik būtini
        </button>
        <button type="button" class="button" data-consent="granted">
          Leisti analitiką
        </button>
      </div>
    </section>
    <script>
      import "../scripts/site";
    </script>
  </body>
</html>
