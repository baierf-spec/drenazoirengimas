---
// Full page: head (SEO, structured data, analytics consent), header, content, LeadHub gallery, footer.
import { readFileSync } from "node:fs";
import { createHash } from "node:crypto";
import { SITE, header, footer } from "../content/site.mjs";
const { page } = Astro.props;
const { path, title, description, body, schema = [], current, headOpts = {}, ogType = "website", noindex = false } = page;
const crumbNode = schema.find((x: { "@type": string }) => x["@type"] === "BreadcrumbList");
const canonical = SITE.url + path;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": SITE.url + "/#website", url: SITE.url + "/", name: SITE.name, inLanguage: "lt-LT" },
    { "@type": "Organization", "@id": SITE.url + "/#org", name: SITE.name, url: SITE.url + "/", logo: SITE.url + "/icon-512.png", email: "info@sklypolyginimas.lt", areaServed: { "@type": "Country", name: "Lietuva" }, knowsAbout: ["Sklypo lyginimas", "Sklypo planiravimas", "Nuolydžių formavimas", "Paruošimas vejai", "Juodžemio atvežimas", "Drenažas"] },
    { "@type": "WebPage", "@id": canonical + "#webpage", url: canonical, name: title, description, inLanguage: "lt-LT", isPartOf: { "@id": SITE.url + "/#website" }, about: { "@id": SITE.url + "/#org" }, dateModified: SITE.updated, primaryImageOfPage: SITE.url + "/og.png", ...(crumbNode ? { breadcrumb: crumbNode } : {}) },
    ...schema,
  ],
};
// Cache-busting version of the shared CSS/JS (same files on every page).
const v = createHash("sha1")
  .update(readFileSync("public/assets/styles.css"))
  .update(readFileSync("public/assets/app.js"))
  .update(readFileSync("public/assets/motion.js"))
  .digest("hex")
  .slice(0, 8);
const gallery = !(noindex || headOpts.minimal || headOpts.partner || path === "/privatumo-politika/");
---
<!doctype html>
<html lang="lt">
<head>
<meta charset="utf-8">
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-TDK1DCZ6MP"></script>
<script is:inline>
  /* eslint-disable prefer-rest-params, no-var, no-empty, @typescript-eslint/no-unused-vars -- Google's gtag snippet, kept verbatim */
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', wait_for_update: 500 });
  try { var c = JSON.parse(localStorage.getItem('sl-consent') || 'null'); if (c && c.v === 'granted' && Date.now() - c.at < 180 * 864e5) gtag('consent', 'update', { analytics_storage: 'granted' }); } catch (e) {}
  gtag('js', new Date());
  gtag('config', 'G-TDK1DCZ6MP');
</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"}>
<link rel="alternate" hreflang="lt" href={canonical}>
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt">
<link rel="canonical" href={canonical}>
<meta property="og:type" content={ogType}>
<meta property="og:locale" content="lt_LT">
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={`${SITE.url}/og.png`}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#16291C">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<script is:inline>/* eslint-disable-next-line no-empty, @typescript-eslint/no-unused-vars -- tiny inline guard */
(function(d){try{if(!matchMedia('(prefers-reduced-motion: reduce)').matches){d.classList.add('m');setTimeout(function(){if(!window.__m)d.classList.remove('m')},3500)}}catch(e){}})(document.documentElement)</script>
<link rel="preload" href="/fonts/bricolage-grotesque-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`/assets/fonts.css?v=${v}`}>
<link rel="stylesheet" href={`/assets/styles.css?v=${v}`}>
<script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />
{SITE.turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body>
<Fragment set:html={header(current, headOpts)} />
<main id="turinys">
<Fragment set:html={body} />
{gallery && <section class="lh-gal" data-lh-gallery hidden aria-labelledby="lh-gal-h"><div class="wrap"><h2 class="h2" id="lh-gal-h">Atlikti darbai</h2><p class="muted" data-lh-gal-sub></p><div class="lh-gal-grid" data-lh-gal-grid></div></div></section>}
</main>
<Fragment set:html={footer()} />
<a class="lh-mbar" data-lh-call hidden href="/uzklausa/"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span>Skambinti <span data-lh-phone></span></span></a>
<div class="ck" data-ck hidden role="region" aria-label="Slapukų pasirinkimas"><p>Lankomumo statistikai naudojame „Google Analytics“ slapukus, tik jei sutinkate. <a href="/privatumo-politika/#slapukai">Plačiau</a></p><div class="ck-act"><button type="button" class="btn-o btn-sm" data-ck-v="denied">Nesutinku</button><button type="button" class="btn btn-sm" data-ck-v="granted">Sutinku</button></div></div>
<script is:inline src={`/assets/motion.js?v=${v}`} defer></script>
<script is:inline src={`/assets/app.js?v=${v}`} defer></script>
</body>
</html>
