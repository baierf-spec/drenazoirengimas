{
  "name": "sklypolyginimas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4177",
    "build": "astro build",
    "build:production": "astro build",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint src worker shared tests && node --check public/assets/app.js && node --check public/assets/motion.js",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "deploy": "npm run build:production && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run"
  },
  "dependencies": {
    "@leadsites/kit": "1.0.0",
    "astro": "7.4.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "^5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.151.2"
  }
}
