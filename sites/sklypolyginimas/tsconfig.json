{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "astro.config.mjs"],
  "exclude": ["dist", "worker", "tests"],
  "compilerOptions": { "allowJs": true, "checkJs": false, "types": ["astro/client"], "noUnusedLocals": true,
