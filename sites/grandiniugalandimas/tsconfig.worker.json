{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "lib": ["ES2022", "WebWorker"], "types": ["@cloudflare/workers-types"], "noUnusedLocals": true, "resolveJsonModule": true,
    "paths": { "@/*": ["./src/*"], "@site/config": ["./shared/site-config.ts"], "@site/lead": ["./worker/site.ts"], "@site/cms": ["../../packages/kit/no-cms.json"] }
  },
  "include": ["worker/**/*.ts", "shared/**/*.ts", "../../packages/kit/src/worker/**/*.ts", "../../packages/kit/src/config.ts"]
}
