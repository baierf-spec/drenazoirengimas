{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Existing production Worker (custom domain grandiniugalandimas.lt); keeps its secrets and vars.
  "name": "growthignition-kit",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-19",
  // Slots of the shared kit (keep in sync with packages/kit/aliases.mjs).
  "alias": {
    "@site/config": "./shared/site-config.ts",
    "@site/lead": "./worker/site.ts",
    "@site/cms": "../../packages/kit/no-cms.json",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": true,
  },
  "keep_vars": true,
  "send_email": [{ "name": "EMAIL" }],
  // LeadHub decides whose contacts and photos the site shows and where enquiries go (secret LEADHUB_SECRET).
  "services": [{ "binding": "LEADHUB", "service": "leadhub" }],
  "vars": { "LEADHUB_SITE_KEY": "grandiniugalandimas" },
  "observability": { "enabled": true },
}
