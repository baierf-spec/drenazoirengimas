---
import Base from "../layouts/Base.astro";
const head = { meta: [{ title: "Puslapis nerastas | Grandinių Galandimas" }] };
---
<Base head={head} noindex>
  <div class="flex min-h-[70vh] items-center justify-center px-4 pt-24">
    <div class="max-w-md text-center">
      <h1 class="text-7xl font-bold">404</h1>
      <h2 class="mt-4 text-xl font-semibold">Puslapis nerastas</h2>
      <p class="mt-2 text-sm text-neutral-400">Tokio puslapio nėra arba jis perkeltas.</p>
      <a href="/" class="mt-6 inline-flex items-center justify-center rounded-md bg-[#c2410c] px-4 py-2 text-sm font-medium text-white hover:bg-[#9a3412]">Į pradžią</a>
    </div>
  </div>
</Base>
