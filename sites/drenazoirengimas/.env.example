# Business/public settings are in site.config.json. No PUBLIC_* build variables needed.
# Local Wrangler only: copy these runtime values into ignored .dev.vars.
TURNSTILE_SECRET_KEY=
# Optional private email references, used only while site.config.json says env:NAME.
# Replace those references with literal addresses in site.config.json if they may be public.
EMAIL_FROM=
ADMIN_EMAIL=
BUSINESS_REPLY_TO=

# Decap GitHub OAuth (Cloudflare runtime secrets; never commit real values)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_SECRET=
