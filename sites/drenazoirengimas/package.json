{
  "name": "drenazoirengimas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4173",
    "build": "astro build && tsx scripts/build-sites.mjs",
    "build:production": "tsx scripts/preflight.mjs && npm run build",
    "preview": "astro preview --host 0.0.0.0",
    "dev:worker": "wrangler dev",
    "lint": "eslint src shared worker ../../packages/kit/src tests scripts astro.config.mjs public/admin/init.js public/admin/prepare.js",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:built": "tsx scripts/check-build.mjs",
    "check": "npm run lint && npm run typecheck && npm run build && npm run audit:seo && npm test && npm run test:built && npm run audit:projects",
    "deploy": "npm run build:production && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir .wrangler-dry-run",
    "optimize:images": "tsx scripts/optimize-images.mjs",
    "format": "prettier --write src shared worker tests scripts *.mjs *.json *.jsonc *.md .github",
    "check:secrets": "tsx scripts/check-secrets.mjs",
    "audit:seo": "tsx scripts/audit-seo.mjs",
    "audit:projects": "tsx scripts/audit-projects.mjs",
    "config:check": "tsx scripts/preflight.mjs",
    "config:schema": "tsx scripts/config-schema.mjs",
    "predev": "npm run cms:prepare",
    "prebuild": "npm run cms:prepare",
    "pretypecheck": "npm run cms:prepare",
    "pretest": "npm run cms:prepare",
    "cms:prepare": "tsx scripts/validate-cms-content.mjs && tsx scripts/generate-cms.mjs && tsx scripts/prepare-content.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.1",
    "heic-to": "1.6.6",
    "jose": "^6.1.0",
    "zod": "4.6.7",
    "@leadsites/kit": "1.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@cloudflare/workers-types": "5.20261019.1",
    "@eslint/js": "^10.0.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.27.3",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "3.2.1",
    "happy-dom": "21.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "wrangler": "4.151.2",
    "yaml": "2.9.1",
    "tsx": "^4.20.6"
  }
}
