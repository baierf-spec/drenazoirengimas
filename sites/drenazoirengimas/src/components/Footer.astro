---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { site } from "../data/site";
---

<footer class="footer">
  <div class="container footer-grid">
    <div>
      <Logo light />
      <p>
        {site.footerLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>
      <p class="small">{site.footerDescription}</p>
    </div>
    <div>
      <strong>Sprendimai</strong>
      <a href="/pamatu-drenazas/">Pamatų drenažas</a>
      <a href="/sklypo-drenazas/">Sklypo drenažas</a>
      <a href="/lietaus-vandens-nuvedimas/">Lietaus vandens nuvedimas</a>
    </div>
    <div>
      <strong>Verta žinoti</strong>
      <a href="/drenazo-kaina/">Drenažo kaina</a>
      <a href="/vanduo-sklype/">Vanduo sklype</a>
      <a href="/drenazas-ar-lietaus-nuotekos/">Drenažas ar lietaus nuotekos?</a>
      <a href="/duk/">Dažniausi klausimai</a>
    </div>
    <div>
      <strong>Pradėkime nuo jūsų situacijos</strong>
      <a href="/gauti-pasiulyma/">
        {site.primaryCta} <Icon name="arrow" size={16} />
      </a>
      <div data-lh data-lh-footer hidden></div>
      <a href="/privatumo-politika/">Privatumo informacija</a>
      <button class="text-button cookie-settings" type="button">
        Slapukų nustatymai
      </button>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>
      © {new Date().getFullYear()} {site.name}
    </span>
    <span>{site.footerArea}</span>
  </div>
</footer>
<div class="mobile-cta">
  <a class="button" href="/gauti-pasiulyma/" data-event="primary_cta_click">
    {site.primaryCta} <Icon name="arrow" size={18} />
  </a>
  <a
    class="button button-navy"
    href="/gauti-pasiulyma/?photos=1"
    data-event="primary_cta_click"
    data-lh
    data-lh-call
  >
    <span data-lh-call-icon="camera"><Icon name="camera" size={18} /></span>
    <span data-lh-call-icon="phone" hidden><Icon name="phone" size={18} /></span>
    <span data-lh-call-label>Nuotraukos</span>
  </a>
</div>
