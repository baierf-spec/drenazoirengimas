---
const { light = false } = Astro.props;
---

<a
  href="/"
  class:list={["logo", { light }]}
  aria-label="Drenažo įrengimas – pradžia"
>
  <svg viewBox="0 0 32 40" width="30" height="38" aria-hidden="true">
    <path
      d="M16 2C12 10 3 18 3 26a13 13 0 0 0 26 0C29 18 20 10 16 2Z"
      fill="#1685bd"
      stroke="#9adff3"
      stroke-width="1.5"
    />
    <path
      d="M16 9c-3 7-7 11-7 17a7 7 0 0 0 7 7"
      fill="none"
      stroke="#fff"
      stroke-width="2.2"
    />
    <path
      d="M18 16v13m-4-4 4 4 4-4"
      fill="none"
      stroke="#8bce52"
      stroke-width="2.5"
    />
  </svg>
  <span>
    drenazoirengimas<span class="logo-dot">.lt</span>
  </span>
</a>
