---
import Article from "../layouts/Article.astro";
import PriceSources from "../components/PriceSources.astro";
import pricing from "../content/pricing.json";
import Estimator from "../components/Estimator.astro";
---

<Article
  title="Kiek kainuoja drenažo įrengimas?"
  description="Orientacinis drenažo kainos modelis ir kainą lemiantys veiksniai. Palyginkite darbų apimtį, medžiagas, priėjimą ir gerbūvio atkūrimą."
>
  <p slot="intro">{pricing.text01}</p>
  <h2>{pricing.text02}</h2>
  <p>{pricing.text03}</p>
  <Estimator />
  <noscript>
    <p class="no-js-note">{pricing.text04}</p>
  </noscript>
  <PriceSources />
  <h2>{pricing.text05}</h2>
  <p>{pricing.text06}</p>
  <p>{pricing.text07}</p>
  <h2>{pricing.text08}</h2>
  <ul>
    {pricing.factors.map((factor) => (
      <li>{factor}</li>
    ))}
  </ul>
  <h2>{pricing.text09}</h2>
  <p>{pricing.text10}</p>
  <p>
    Tikslesniam pasiūlymui pateikite{" "}
    <a href="/gauti-pasiulyma/">objekto vietą ir situaciją</a>. Tikslių metrų
    žinoti nebūtina.
  </p>
</Article>
