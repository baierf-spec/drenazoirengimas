---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
---

<Base
  title="Puslapis nerastas | drenazoirengimas.lt"
  description="Šio puslapio nėra. Grįžkite į pradžią arba pateikite užklausą dėl vandens problemos."
  noindex
  simple
>
  <section class="flow-shell flow-message">
    <span class="eyebrow">404 · PUSLAPIS NERASTAS</span>
    <h1>Čia kelias baigiasi.</h1>
    <p>
      Ieškomo puslapio nėra. Pradžios puslapyje rasite informaciją apie drenažą
      ir vandens problemas.
    </p>
    <a class="button" href="/">
      Grįžti į pradžią <Icon name="arrow" size={18} />
    </a>
  </section>
</Base>
