{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "astro.config.mjs",
    "../../packages/kit/src/client/**/*.ts"
  ],
  "exclude": [
    "dist",
    "worker",
    "tests"
  ],
  "compilerOptions": {
    "types": [
      "astro/client"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "paths": {
      "@site/config": [
        "./shared/site-config.ts"
      ],
      "@site/lead": [
        "./worker/site.ts"
      ],
      "@site/cms": [
        "./cms.config.json"
      ]
    }
  }
}
